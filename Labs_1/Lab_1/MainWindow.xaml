<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Import Pipeline" Height="250" Width="450">
    <StackPanel Margin="20">
        <Button Content="Обрати файл" Command="{Binding SelectFileCommand}" Padding="5" />
        <TextBlock Text="{Binding SelectedFilePath}" Margin="0,10" TextWrapping="Wrap" />
        <Button Content="Імпортувати" Command="{Binding RunImportCommand}" Padding="5" Margin="0,0,0,10" />
        <ProgressBar Value="{Binding Progress}" Height="20" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,10" TextWrapping="Wrap" />
    </StackPanel>
</Window>